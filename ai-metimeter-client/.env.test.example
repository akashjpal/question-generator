# Copy this file to .env.test and fill in real values before running `npm run test:e2e`.
# playwright.config.ts auto-loads .env.test via dotenv — no manual export/source step needed.

# Credentials for a real, dedicated Supabase test TEACHER account.
# This MUST be a dedicated test account created solely for e2e runs — NEVER a real
# production/personal teacher account or one shared with other purposes.
# Used once by e2e/global-setup.ts to log in via the real login form and cache the session.
TEST_TEACHER_EMAIL=teacher-e2e@example.com
TEST_TEACHER_PASSWORD=change-me

# Frontend base URL the suite runs against. Defaults to http://localhost:4200 (ng serve) if unset.
PLAYWRIGHT_BASE_URL=http://localhost:4200
