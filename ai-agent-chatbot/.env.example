# Copy to .env for local (non-docker) runs. In docker-compose these are injected
# from the root .env via docker-compose.yml — this file is a reference only.

PORT=8010

# ── Supabase (same project as the rest of the platform) ────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Existing Question Generator API (Bun/Express) ───────────────
# Internal docker network URL in compose; localhost for local dev.
QUESTION_GENERATOR_API_URL=http://localhost:3000

# ── OpenRouter — agent's own conversational/tool-calling model ─
# Shared key with question-generator-worker's OPENROUTER_API_KEY, separate
# model var (AGENT_OPENROUTER_MODEL) so tuning one doesn't fight the other.
OPENROUTER_API_KEY=your-openrouter-api-key
AGENT_OPENROUTER_MODEL=moonshotai/kimi-k2

# ── Frontend origin, for building attempt links server-side ────
FRONTEND_ORIGIN=http://localhost:4200

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200
