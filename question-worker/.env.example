# Copy to .env for local (non-docker-compose) runs. In docker-compose these are
# all injected via the fastapi-worker service block instead.

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenRouter LLM ───────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key
LLM_MODEL=moonshotai/kimi-k2
JUDGE_MODEL=moonshotai/kimi-k2
EMBEDDING_MODEL=openai/text-embedding-3-small

# ── AWS / ministack ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
# Unset (or delete this line) for real AWS in production.
AWS_ENDPOINT=http://ministack:4566
AWS_BUCKET_CORRECT=correct-files

SQS_QUEUE_URL=http://ministack:4566/000000000000/question-generator
SQS_DLQ_URL=http://ministack:4566/000000000000/question-generator-dlq
SQS_MAX_MESSAGES=5
SQS_WAIT_TIME=20
SQS_VISIBILITY_TIMEOUT=120
SQS_MAX_RECEIVE_COUNT=3
VISIBILITY_HEARTBEAT_INTERVAL=60
WORKER_CONCURRENCY=3

# ── Pipeline tuning ──────────────────────────────────────────
MAX_REGENERATION_ROUNDS=3
DUPLICATE_SIMILARITY_THRESHOLD=0.90
MIN_EXTRACTED_CHARS=200
MIN_CHARS_PER_QUESTION=400
