# ==============================================================
# Copy this file to .env and fill in your values
# ==============================================================

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET_ID=question-generator-content

# ── OpenRouter LLM ───────────────────────────────────────────
# Shared key across services, one model var per service so tuning one
# doesn't fight the other: OPENROUTER_MODEL is question-generator-worker's
# strict-JSON MCQ extraction model; AGENT_OPENROUTER_MODEL is
# ai-agent-chatbot's conversational/tool-calling model. Both default to
# Kimi K2 (moonshotai/kimi-k2) via OpenRouter's OpenAI-compatible API.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=moonshotai/kimi-k2
AGENT_OPENROUTER_MODEL=moonshotai/kimi-k2

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-to-a-strong-password

# ── Database (.NET APIs) ──────────────────────────────────────
DATABASE_CONNECTION_STRING=Host=your-supabase-db-host;Port=5432;Database=postgres;Username=postgres;Password=your-db-password

# ── CORS (comma-separated origins) ───────────────────────────
CORS_ORIGIN=http://localhost

# ── Agentic Chatbot (ai-agent-chatbot) ───────────────────────
# Needed server-side to build attempt links (${FRONTEND_ORIGIN}/attempt/:id) —
# previously only ever computed client-side via window.location.origin.
FRONTEND_ORIGIN=http://localhost:4200

# ── Arize Phoenix LLM Observability ──────────────────────────
# Set this to enable tracing. When using docker-compose the value below
# is injected automatically; override only for external/hosted Phoenix.
# Leave blank to disable tracing.
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:4317
